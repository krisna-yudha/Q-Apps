# ==============================================================================
# DigiQA - Docker Deployment Environment Configuration (.env.docker)
# ==============================================================================

# Application Environment
APP_NAME=DigiQA
APP_ENV=production
APP_KEY=base64:paMkD4ChWfL65+IBJNQ6ywygftDHJISi2XwFITsJ8EA=
APP_DEBUG=false
APP_URL=http://localhost
APP_PORT=80
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# MySQL Database (Docker Container: db)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=qa_db
DB_USERNAME=digiqa_user
DB_PASSWORD=digiqa_secret_pass
DB_ROOT_PASSWORD=digiqa_root_secret_pass

# Cache & Session Stores
# Menggunakan Redis container untuk performa tinggi & low-latency
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
FILESYSTEM_DISK=local

# Queue Connection
# Menggunakan database queue agar kompatibel dengan tabel jobs Laravel
QUEUE_CONNECTION=database

# Redis Service (Docker Container: redis)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Logging Settings
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# phpMyAdmin Port (Database Web GUI)
PMA_PORT=8081

# Otomatis jalankan migrasi saat container backend pertama kali start
AUTO_MIGRATE=true

# Spatie Backup Notification Email (Optional)
BACKUP_NOTIFICATION_EMAIL=admin@digiqa.local
