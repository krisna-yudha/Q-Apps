# ==============================================================================
# digiQA / Qapps - Frontend Environment Configuration
# ==============================================================================
# File ini digunakan untuk mengatur target API URL sesuai skenario deployment.
# Rename atau copy file ini menjadi .env atau .env.production saat deploy.

# ------------------------------------------------------------------------------
# 1. PENGEMBANGAN LOKAL (DEFAULT)
# ------------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000/api

# ------------------------------------------------------------------------------
# 2. AKSES VIA JARINGAN LOKAL (WI-FI / LAN / MOBILE TESTING)
# Ganti IP di bawah dengan IP Address komputer host di jaringan Wi-Fi:
# ------------------------------------------------------------------------------
# VITE_API_URL=http://192.168.1.50:8000/api

# ------------------------------------------------------------------------------
# 3. PRODUCTION DENGAN NGINX / APACHE REVERSE PROXY (SAME DOMAIN)
# Frontend dan Backend berada pada domain yang sama (misal: https://qapps.pln.co.id):
# ------------------------------------------------------------------------------
# VITE_API_URL=/api

# ------------------------------------------------------------------------------
# 4. PRODUCTION DENGAN DEDICATED SUBDOMAIN BACKEND
# Backend di subdomain terpisah:
# ------------------------------------------------------------------------------
# VITE_API_URL=https://api.qapps.pln.co.id/api

# ------------------------------------------------------------------------------
# 5. XAMPP HTDOCS SUBFOLDER DEPLOYMENT
# Jika di-host langsung di dalam folder web server XAMPP (Apache):
# ------------------------------------------------------------------------------
# VITE_API_URL=http://localhost/digiQa/backend/public/api
